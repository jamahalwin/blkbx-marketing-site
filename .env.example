PORT=3000
BASE_URL=https://blkbx.co
ADMIN_TOKEN=replace-with-a-long-random-secret

# Storage. Leave the database variables unset locally and the app falls back to
# JSON Lines files under data/ - fine for development, NOT durable on managed
# hosts, where the app directory is replaced on every deployment.
#
# On GoDaddy nothing goes here: DB_HOST, DB_PORT, DB_NAME, DB_USER and
# DB_PASSWORD are injected automatically when the hosted database is attached,
# and the app switches to MySQL as soon as it sees DB_HOST.
#
# To point local development at a MySQL instance, set the same names:
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# A single connection string also works, if you prefer:
# DATABASE_URL=mysql://user:password@host:3306/dbname
# Set to "true" if the server requires TLS, or "skip-verify" for a self-signed cert.
# DB_SSL=

# Meta Pixel. Public by nature - it is visible to every visitor - so it is safe
# in source control, but it is read from the environment so a test pixel can be
# used locally. Numeric ID from Events Manager. Leave unset to disable the pixel.
META_PIXEL_ID=

# Optional. If omitted, reservation clicks are still recorded as demand signals,
# but no payment is taken.
STRIPE_SECRET_KEY=
